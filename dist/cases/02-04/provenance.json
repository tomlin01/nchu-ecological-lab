  "historical_case_json": {
    "id": "02-04",
    "name": "California IFCB Network：海水顯微影像的浮游植物分類",
    "year": "2022分類器比較論文（2020資料）；2026查閱持續觀測網絡",
    "context": "加州沿岸碼頭、浮標與航次的Imaging FlowCytobot觀測，包含Monterey Bay與San Francisco Bay的潛在有害浮游植物。",
    "ai_role": "以人工辨識的當地影像建立random forest或CNN，將自動顯微攝影中的顆粒分到浮游植物分類群。不同模型可辨24至54類；許多標籤在屬或形態群層級，不是每張影像皆能確定物種。",
    "outputs": "逐影像分類群標籤、樣本體積校正後的分類群濃度與時間序列，以及供人工追查的原始細胞影像。",
    "demonstrated": "官方網頁確認12台IFCB構成沿岸網絡，並以ML分類。2022會議論文比較2020年雙儀器並列部署與8個月分類結果，另以whole-cell probe計數對照，顯示區域分類器及儀器設定均影響結果。",
    "stage": "operational",
    "stage_detail": "持續觀測網絡已有實際站點與資料入口；較早的分類器比較提供方法驗證，不能推定所有現行站點都沿用同一模型版本。",
    "limits": "鏈狀藻的一張影像可能含多細胞，直接按圖計數會低估濃度；相似分類器結果不是獨立真值。辨出潛在有害分類群，也不等於直接量到毒素。",
    "sources": [
      {
        "title": "CA Imaging FlowCytobot Network",
        "url": "https://sccoos.org/ifcb/",
        "year": "未標示；2026-10-14查閱",
